<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <p><a href="/new-project">Add a New Service Project</a></p>

    <% if (flash && flash.success) { %>
        <div class="alert alert-success">
            <%= flash.success %>
        </div>
    <% } %>

    <% if (flash && flash.error) { %>
        <div class="alert alert-danger">
            <%= flash.error %>
        </div>
    <% } %>

    <ul>
        <% if (projects && projects.length > 0) { %>
            <% projects.forEach(project => { %>
                <li>
                    <a href="/project/<%= project.project_id %>"><%= project.title %></a>
                    -
                    <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
                </li>
            <% }) %>
        <% } else { %>
            <li>No upcoming projects found.</li>
        <% } %>
    </ul>
</main>

<%- include('partials/footer') %>
